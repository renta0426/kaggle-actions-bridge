class BundleContractError(RuntimeError):
    """Raised when the generated bundle or Kaggle runtime violates its contract."""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input-dir", type=Path)
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=Path("/kaggle/working/cmi-flu-b2"),
    )
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args()


def package_bytes() -> bytes:
    encoded = "".join(PACKAGE_B64.split())
    try:
        data = base64.b64decode(encoded, validate=True)
    except Exception as error:
        raise BundleContractError("embedded package is not valid base64") from error
    actual = hashlib.sha256(data).hexdigest()
    if actual != PACKAGE_ZIP_SHA256:
        raise BundleContractError("embedded package SHA-256 mismatch")
    with zipfile.ZipFile(io.BytesIO(data)) as archive:
        bad = archive.testzip()
        names = set(archive.namelist())
    if bad is not None:
        raise BundleContractError(f"embedded package has a corrupt member: {bad}")
    required = {
        "cmi_flu/__init__.py",
        "cmi_flu/runner.py",
        "cmi_flu/evaluation.py",
        "cmi_flu/datasets.py",
        "cmi_flu/models.py",
    }
    missing = sorted(required - names)
    if missing:
        raise BundleContractError(f"embedded package is missing modules: {missing}")
    return data


def self_test() -> int:
    data = package_bytes()
    print(
        "CMI_FLU_B2_BUNDLE_SELF_TEST PASS "
        f"source_commit={SOURCE_COMMIT} package_bytes={len(data)} "
        f"package_sha256={PACKAGE_ZIP_SHA256}"
    )
