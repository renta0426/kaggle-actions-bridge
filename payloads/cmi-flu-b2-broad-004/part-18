replace")
    ).hexdigest()[:20]
    payload = {
        "schema_version": 1,
        "request_id": REQUEST_ID,
        "competition": COMPETITION,
        "source_commit": SOURCE_COMMIT,
        "stage": stage,
        "exception_type": type(error).__name__,
        "error_code": error_code,
    }
    (output_dir / "bridge-failure.json").write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(
        "CMI_FLU_B2_FAILED "
        f"stage={stage} exception_type={type(error).__name__} error_code={error_code}"
    )


