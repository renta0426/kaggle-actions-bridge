{
  "schema_version": 1,
  "experiment_id": "shadow-gold-architecture-transfer-v1",
  "phase": "P4-stage2-transfer",
  "role": "gold_controlled_benchmark",
  "purpose": "Measure architecture-only transfer of membership-inference signals between project-trained GPT-2-style and Llama-style causal language models while holding corpus membership, exposure, tokenizer, sequence order, optimizer, and evaluation cohort fixed.",
  "runtime_parent": "shadow-gpu-t4x2-pilot-v1",
  "pilot_required_status": "pass",
  "data": {
    "kind": "deterministic_generated_code_like_corpus",
    "languages": ["Go", "Java", "Python", "Ruby", "Rust"],
    "candidate_rows_per_language": 2048,
    "candidate_rows_total": 10240,
    "synthetic_family_size": 4,
    "synthetic_families_per_language": 512,
    "preexisting_membership_labels_present": false,
    "competition_rows_used": 0,
    "evaluation_inputs_generated_by_project": true,
    "evaluation_labels_exact_by_construction": true
  },
  "controlled_split": {
    "split_version": "controlled-membership-transfer-v1",
    "seed": 2027,
    "group_column": "synthetic_family_id",
    "member_fraction": 0.5,
    "eval_rows_per_language_per_class": 512,
    "min_eval_rows_per_language_per_class": 512,
    "expected_evaluation_rows": 5120,
    "expected_evaluation_member_rows": 2560,
    "expected_evaluation_nonmember_rows": 2560,
    "expected_training_corpus_rows": 5120,
    "min_characters": 64,
    "max_characters": 32000,
    "length_bin_edges": [0, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32001],
    "near_duplicate_threshold": 0.85,
    "member_nonmember_source_clusters_must_be_disjoint": true,
    "matched_pairs_required": true
  },
  "protocol": {
    "protocol_version": "controlled-shadow-protocol-v1",
    "tokenizer": "lossless_utf8_bytes",
    "max_sequence_tokens": 256,
    "seed": 2027,
    "global_batch_size": 64,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "warmup_fraction": 0.05,
    "gradient_clip_norm": 1.0,
    "exposure_repeats": 4,
    "expected_training_sequences": 20480,
    "expected_optimizer_steps_per_architecture": 320,
    "architecture_pair": ["shadow-gpt2-byte-5m", "shadow-llama-byte-5m"],
    "random_initialisation": true,
    "pretrained_weights_used": false
  },
  "runtime": {
    "backend": "cuda",
    "accelerator": "gpu",
    "kaggle_machine_shape": "NvidiaTeslaT4",
    "expected_visible_gpu_count": 2,
    "expected_gpu_name_contains": "T4",
    "architecture_gpu_assignment": {"left": 0, "right": 1},
    "per_architecture_world_size": 1,
    "distributed_training": false,
    "ddp_used": false,
    "nccl_used": false,
    "run_architectures_concurrently": true,
    "checkpoint_reload_atol": 1e-05,
    "automatic_compute_retries": 0,
    "notebook_internet": false
  },
  "scoring": {
    "label_free_before_reveal": true,
    "generic_stage2_api_required": true,
    "primitive_families": ["loss", "min_kpp", "local_span", "rank"],
    "retain_primitive_feature_matrix": true,
    "benchmark_ids_must_not_be_model_features": true,
    "false_positive_rate": 0.01
  },
  "transfer_protocol": {
    "fit_architecture_slot": "left",
    "blind_transfer_architecture_slot": "right",
    "fit_labels_allowed_only_after_left_predictions_are_sealed": true,
    "right_labels_forbidden_until_frozen_attack_and_right_predictions_are_sealed": true,
    "candidate_selection_metric_primary": "partial_auc_standardized_at_1pct_fpr",
    "candidate_selection_metric_secondary": "tpr_at_1pct_fpr",
    "report_plain_loss": true,
    "report_local_64": true,
    "report_all_predeclared_primitives": true,
    "frozen_attack_must_be_applied_unchanged_to_right": true
  },
  "reporting": {
    "overall_auc": true,
    "standardized_partial_auc": true,
    "tpr_at_1pct_fpr": true,
    "per_language": true,
    "per_length_bin": true,
    "matched_pair_accuracy": true,
    "score_length_correlation": true,
    "left_to_right_metric_delta": true
  },
  "scientific_guards": {
    "stage2_v3_selection_allowed_from_this_benchmark_alone": false,
    "external_model_holdout_consumed": false,
    "smollm2_labels_used": false,
    "public_leaderboard_feedback_used": false,
    "hidden_stage1_validation_labels_used": false,
    "interpret_as_architecture_only_causal_evidence": true,
    "interpret_as_real_external_model_transfer_evidence": false
  }
}
