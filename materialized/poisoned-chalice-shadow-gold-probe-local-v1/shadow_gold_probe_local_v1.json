{
  "schema_version": 1,
  "execution_id": "shadow-gold-probe-local-v1",
  "role": "gold_positive_control_probe_local_calibration",
  "purpose": "Disambiguate whether the failed generic positive-control gate is caused by absent memorization or by file-level aggregation. This is calibration-only and cannot select Stage2-v3 features.",
  "base_positive_control": {
    "scientific_experiment_id": "shadow-gold-positive-control-v1",
    "successful_execution_id": "shadow-gold-positive-control-v2",
